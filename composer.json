{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "michal78/laravel-pandora",
    "description": "Pandora — a Laravel-native agentic framework: agents, tools, approvals, automations, memory and a Livewire control center.",
    "keywords": ["laravel", "agents", "ai", "llm", "livewire", "reverb", "agentic"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "dragonmantank/cron-expression": "^3.4",
        "symfony/uid": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^4.1",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the Pandora control center UI.",
        "laravel/reverb": "Required for realtime streaming of runs, tool calls and approvals.",
        "guzzlehttp/guzzle": "Required by the HTTP-based provider adapters.",
        "league/flysystem-aws-s3-v3": "Required for workspaces and context files on S3-compatible object storage (AWS, DigitalOcean, Hetzner, MinIO, R2)."
    },
    "autoload": {
        "psr-4": {
            "Pandora\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pandora\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev",
            "dev-development": "0.2.x-dev"
        },
        "laravel": {
            "providers": [
                "Pandora\\PandoraServiceProvider"
            ],
            "aliases": {
                "Pandora": "Pandora\\Facades\\Pandora"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    }
}
