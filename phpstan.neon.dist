includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - src
        - database

    tmpDir: build/phpstan

    # Verify that every model attribute we touch is genuinely declared. This is
    # what keeps the @property blocks on the models honest as the schema grows.
    checkModelProperties: true

    ignoreErrors:
        # ---------------------------------------------------------------------
        # Every entry below is a tool limitation, not a suppressed defect.
        # A new entry requires a stated reason.
        # ---------------------------------------------------------------------

        # Eloquent relations are resolved generically at runtime.
        - identifier: missingType.generics

        # Package views resolve through the `pandora::` namespace at runtime.
        # Larastan can only prove `view-string` for views it can locate on the
        # host application's configured view paths, which by definition
        # excludes a package's own namespaced views.
        -
            identifier: argument.type
            message: '#\$view of function view expects view-string\|null, string given#'
            path: src/UI/Livewire/*.php

        # BelongsToTenant is deliberately generic across every Pandora model and
        # builds its column name from the model's own table at runtime. A
        # statically-known model property is impossible here by design.
        -
            identifier: argument.type
            path: src/Core/Tenancy/Concerns/BelongsToTenant.php

        # `acrossAllTenants()` lives on that same generic trait and is typed as
        # a plain Builder, so the concrete model's properties are invisible to
        # the cross-tenant authorization checks that call it.
        -
            identifier: argument.type
            message: '#Builder<Illuminate\\Database\\Eloquent\\Model>::where\(\)#'
            path: src/Realtime/ChannelAuthorizer.php

        # `create()`/`firstOrCreate()` are typed as array<model property, mixed>.
        # Pandora builds attribute arrays dynamically -- config defaults merged
        # with definition values, conditional tenant stamping -- which that
        # signature cannot express.
        -
            identifier: argument.type
            message: '#\$attributes of method Illuminate\\Database\\Eloquent\\Builder<.*>::(create|firstOrCreate)\(\) expects#'

        # `pluck()`/`latest()` over a raw aggregate select, where the column is
        # a SQL alias rather than a model property.
        -
            identifier: argument.type
            message: '#\$column of method Illuminate\\Database\\Eloquent\\Builder<.*>::(pluck|latest)\(\) expects#'

        # Nullsafe on the left of `??`. PHPStan narrows the *property* to
        # non-nullable and calls the operator redundant, but the *object* is
        # nullable and the nullsafe is precisely what makes the `??` reachable.
        - identifier: nullsafe.neverNull
